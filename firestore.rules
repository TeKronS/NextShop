rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Permisos para perfiles de usuario
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Permisos para productos
    match /products/{productId} {
      // Cualquiera puede ver los productos
      allow read: if true;
      
      // Solo usuarios autenticados pueden crear productos y deben ser los dueños
      allow create: if request.auth != null && request.resource.data.sellerId == request.auth.uid;
      
      // Solo el vendedor original puede editar o eliminar su producto
      allow update, delete: if request.auth != null && resource.data.sellerId == request.auth.uid;
    }
  }
}